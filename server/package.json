{
  "name": "todo-api",
  "version": "1.0.0",
  "description": "REST API for the To-Do List app (Express + MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "seed": "node --env-file-if-exists=.env src/utils/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.15.0",
    "morgan": "^1.10.0",
    "serverless-http": "^3.2.0",
    "zod": "^3.25.0"
  }
}
